<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--
        No SwipeRefreshLayout here on purpose: a pull-down gesture fights the
        GUI's own scrolling and text selection (and kept firing when the intent
        was to select text), so refresh lives in the options menu instead.
    -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Friendly "cannot reach host" overlay, hidden by default. -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/accent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/unreachable_title"
            android:src="@drawable/ic_scan"
            app:tint="@color/surface" />

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/unreachable_title"
            android:textColor="@color/surface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/unreachable_message"
            android:gravity="center"
            android:textColor="#C4C7D8"
            android:textSize="14sp" />

        <!-- Concrete diagnostics: which host failed, whether the phone has a
             network, and when the host last answered. Filled at runtime. -->
        <TextView
            android:id="@+id/errorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#8A8FA8"
            android:textSize="12sp"
            tools:text="主机：http://192.168.1.100:3080\n网络：手机无网络连接\n上次成功连接：2026-09-27 21:08" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/retry" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepair"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/re_pair"
            android:textColor="@color/surface" />

    </LinearLayout>

    <!-- Spinner shown while verifying pairing / first-loading (avoids a white flash). -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        app:indicatorSize="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackThickness="6dp" />

    <!--
        A visible entry for the app's own options (re-pair, background alerts,
        app lock). This used to be a long-press on Back, which is unreachable
        under gesture navigation, plus a three-tap on the error page, which only
        exists when the host is down — so there was effectively no way in.
        Small and semi-transparent to stay out of the GUI's way.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOptions"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_margin="4dp"
        android:alpha="0.5"
        android:contentDescription="@string/options_title"
        android:fontFamily="sans-serif"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="⋯"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:backgroundTint="@color/surface"
        app:cornerRadius="15dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>