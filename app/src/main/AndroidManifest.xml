<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Read connectivity: the network callback that reconnects after an outage,
         the "no network" line on the error page, and the watcher's reachability. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Camera for first-run QR pairing. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required to install the downloaded update APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13+ runtime permission for the agent alerts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Background watcher: keeps the mux socket and presence heartbeat alive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Restart the watcher after a reboot and after an in-app update. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RemoteApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeepSeekRemote"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- Shown instead of MainActivity while the local app lock is engaged.
             No android:noHistory here: that finishes the activity the moment it
             is covered, so sending the user to Settings and coming Back landed
             on the launcher instead of the lock screen. -->
        <activity
            android:name=".AppLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.DeepSeekRemote" />

        <!-- Shows the last recorded crash so it can be copied without adb. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/crash_title"
            android:theme="@style/Theme.DeepSeekRemote" />

        <!-- Receives ACTION_SEND from other apps. -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run pairing: scan QR or paste a pairing link. -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.DeepSeekRemote" />

        <!-- ZXing barcode capture screen. -->
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

        <!-- Background watcher: notifications while the app is closed. -->
        <service
            android:name=".HostWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="com.dsh.remote.action.STOP_WATCH" />
            </intent-filter>
        </service>

        <!-- Home-screen connection status. -->
        <receiver
            android:name=".WatchWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watch_widget_info" />
        </receiver>

        <!-- Restarts the watcher after a reboot / app update. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exposes the downloaded update APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
